{
  "name": "job-ai-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:agent": "npm run dev -w apps/agent",
    "run:agent": "npm run pipeline -w apps/agent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker-compose up -d --wait",
    "db:down": "docker-compose down",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/agent --",
    "db:seed": "npm run db:seed -w apps/agent",
    "db:create-test": "docker-compose exec -T db createdb -U postgres jobagent_test",
    "profile:import": "npm run profile:import -w apps/agent",
    "resume:import": "npm run resume:import -w apps/agent",
    "filter:report": "npm run filter:report -w apps/agent --",
    "similarity:report": "npm run similarity:report -w apps/agent --",
    "score:report": "npm run score:report -w apps/agent --",
    "eval:label": "npm run eval:label -w apps/agent --",
    "eval": "npm run eval -w apps/agent --"
  }
}
