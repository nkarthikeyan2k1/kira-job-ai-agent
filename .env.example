# Docker Postgres is on 5433: 5432 is used by a local Homebrew Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/jobagent
OLLAMA_URL=http://localhost:11434
GMAIL_USER=
GMAIL_APP_PASSWORD=

# agent API
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# web → agent (read by apps/web; set in apps/web/.env.local if it differs)
AGENT_URL=http://127.0.0.1:4000

# throwaway DB for integration tests (wiped on every run; create with `npm run db:create-test`)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/jobagent_test
