{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // Consumed as TypeScript source (tsx, Next.js), so imports use .ts paths.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
