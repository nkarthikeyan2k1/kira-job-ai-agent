{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Source runs directly with tsx; nothing is emitted, so imports use .ts paths.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "config"]
}
